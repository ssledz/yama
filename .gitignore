# --- Secrets (never commit) ---------------------------------------------------
# API keys live only in env vars; .env.template is the committed reference.
.env
.env.*
!.env.template
.envrc
.direnv/

# --- sbt / Scala --------------------------------------------------------------
target/
project/target/
project/project/
.bsp/
.scala-build/
*.class
*.log
hs_err_pid*.log

# --- Metals / Bloop (generated by the IDE) ------------------------------------
.bloop/
.metals/
project/.bloop/
project/metals.sbt
project/project/metals.sbt
.ammonite/
*.worksheet.sc.out

# --- IDEs / editors -----------------------------------------------------------
.idea/
*.iml
.vscode/
*.swp
*~

# --- Claude Code / local MCP (machine-specific) -------------------------------
.claude/settings.local.json
.mcp.json
.mcp-info.json

# --- Node (vendored files-mcp server) -----------------------------------------
node_modules/
mcp/**/dist/
npm-debug.log*

# --- Runtime data -------------------------------------------------------------
# Agent sandbox: everything the agent writes stays local.
sandbox/*
!sandbox/.gitkeep

# --- OS -----------------------------------------------------------------------
.DS_Store
Thumbs.db
