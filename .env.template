# Copy to .env and fill in. Secrets only: everything else lives in config.json.
# The JVM does not read .env files: load it with `set -a; source .env; set +a` (or direnv).

# Only the selected provider's key is required.
OPENAI_API_KEY=
OPENROUTER_API_KEY=
DEEPSEEK_API_KEY=

# Remote MCP server for the research_agent worker (optional: without it the subagent is disabled).
TAVILY_API_KEY=

# Optional overrides (a CLI flag beats these, these beat config.json).
# YAMA_PROVIDER=openrouter
# YAMA_MODEL=openai/gpt-4.1
